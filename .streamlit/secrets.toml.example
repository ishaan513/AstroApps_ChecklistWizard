# Copy to .streamlit/secrets.toml and replace the placeholders.
# .streamlit/secrets.toml is gitignored. Do not commit real keys.
# Use the project URL and anon (public) key from the Supabase dashboard:
# Project Settings -> API.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
